     58	      =0080		     LCR_DLAB	     EQU 80h		     ; Divisor Latch Access Bit
     59	      =0003		     LCR_8N1	     EQU 03h		     ; 8 data bits, no parity, 1 stop
     60	      =0001		     FCR_ENABLE	     EQU 01h		     ; Enable FIFO
     61	      =0006		     FCR_CLEAR	     EQU 06h		     ; Clear TX/RX FIFOs
     62	      =0080		     FCR_TRIGGER_8   EQU 80h		     ; 8-byte trigger level
     63	      =0001		     MCR_DTR	     EQU 01h		     ; Data Terminal Ready
     64	      =0002		     MCR_RTS	     EQU 02h		     ; Request To Send
     65	      =0008		     MCR_OUT2	     EQU 08h		     ; OUT2 (enable IRQ)
     66
     67				     ; Parallel	Port Register Offsets
     68	      =0000		     LPT_DATA	     EQU 0		     ; Data register
     69	      =0001		     LPT_STATUS	     EQU 1		     ; Status register
     70	      =0002		     LPT_CONTROL     EQU 2		     ; Control register
     71	      =0003		     LPT_EPP_ADDR    EQU 3		     ; EPP address port
     72	      =0004		     LPT_EPP_DATA    EQU 4		     ; EPP data	port
     73	      =0402		     LPT_ECR	     EQU 402h		     ; Extended	Control	Register
     74
     75				     ; Parallel	Port Control Bits
     76	      =0001		     LPT_CTRL_STROBE EQU 01h		     ; Strobe
     77	      =0002		     LPT_CTRL_AUTOFD EQU 02h		     ; Auto Line Feed
     78	      =0004		     LPT_CTRL_INIT   EQU 04h		     ; Initialize
     79	      =0008		     LPT_CTRL_SELECT EQU 08h		     ; Select In
     80	      =0010		     LPT_CTRL_IRQ    EQU 10h		     ; Enable IRQ
     81	      =0020		     LPT_CTRL_BIDIR  EQU 20h		     ; Bidirectional enable (PS/2)
     82
     83				     ; Parallel	Port Status Bits
     84	      =0004		     LPT_STAT_NIRQ   EQU 04h		     ; nIRQ (active low) - interrupt pending
     85	      =0008		     LPT_STAT_ERROR  EQU 08h		     ; nError (active low)
     86	      =0010		     LPT_STAT_ONLINE EQU 10h		     ; Select/Online
     87	      =0020		     LPT_STAT_PAPER  EQU 20h		     ; Paper Out
     88	      =0040		     LPT_STAT_NACK   EQU 40h		     ; nAck (active low) - data	acknowledged
     89	      =0080		     LPT_STAT_NBUSY  EQU 80h		     ; nBusy (active low) - peripheral busy
     90
     91				     ; Buffer Sizes
     92	      =1000		     RX_BUFFER_SIZE  EQU 4096		     ; 4KB receive circular buffer
     93	      =0800		     TX_BUFFER_SIZE  EQU 2048		     ; 2KB transmit queue
     94
     95				     ; Timing Constants
     96	      =00C8		     RETRY_TIMEOUT   EQU 200		     ; 200ms timeout
     97	      =0002		     MAX_RETRIES     EQU 2		     ; Maximum retry attempts
     98	      =0200		     MAX_CONFIG_LEN  EQU 512		     ; Maximum config string length
     99
    100				     ; MLID Control Function Codes
    101	      =0001		     MLID_RESET	     EQU 01h
    102	      =0002		     MLID_SHUTDOWN   EQU 02h
    103	      =0005		     MLID_GET_STATS  EQU 05h
    104	      =0006		     MLID_SEND_PKT   EQU 06h
    105	      =0007		     MLID_REG_RX     EQU 07h
    106
    107				     ; ECB (Event Control Block) Structure Offsets
    108	      =0000		     ECB_Link	     EQU 0		     ; DD - Link to next ECB
    109	      =0004		     ECB_ESR	     EQU 4		     ; DD - Event Service Routine
    110	      =0008		     ECB_InUse	     EQU 8		     ; DB - In use flag
    111	      =0009		     ECB_CompCode    EQU 9		     ; DB - Completion code
    112	      =000A		     ECB_Socket	     EQU 10		     ; DW - Socket number
    113	      =000C		     ECB_IPXWork     EQU 12		     ; 4 bytes - IPX workspace
    114	      =0010		     ECB_DriverWork  EQU 16		     ; 12 bytes	- Driver workspace
